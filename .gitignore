# Godot 4+ specific ignores
.godot/
/build/
/v1/.godot/export_credentials.cfg
/v1/android/

# Local diagnostics, temporary jobs, and editor settings.
/v1/art_source/.build/
/.vscode/

# Local Godot engine binaries stay outside the game project.
/Godot*.exe
__pycache__/

# Native v2 acceleration is built locally or by CI, never checked in as binaries.
/v2/native/.build/
/v2/native/bin/
/v2/native/runtime.gdextension
/v2/native/runtime.gdextension.uid
