{
  "name": "atd-browser-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bridge": "node tools/build-bridge.mjs",
    "export:web": "node tools/export-web.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tools/stage-site.py && playwright test",
    "check:project": "node tools/project.mjs",
    "config:check": "node tools/check-config.mjs",
    "config:reference": "node tools/config-reference.mjs",
    "stage:site": "python tools/stage-site.py",
    "serve:site": "node tools/serve.mjs --site"
  },
  "dependencies": {
    "@trystero-p2p/ws-relay": "0.26.0",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "ws": "8.22.1"
  }
}
